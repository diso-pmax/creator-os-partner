meta {
  name: Send events in one batch
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/integrations/events/batch
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

vars:pre-request {
  channel: EVENT
}

body:json {
  {
    "events": [
      {
        "eventId": "evt-batch-{{stamp}}-1",
        "externalUserId": "{{externalUserId}}",
        "type": "{{eventType}}",
        "occurredAt": "{{now}}",
        "payload": { "orderId": "SO-B1-{{stamp}}", "amountMinor": 100000, "currency": "VND" }
      }
    ]
  }
}

docs {
  Needs batch delivery enabled for your key (422 batch_not_enabled otherwise).
}
