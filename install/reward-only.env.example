# ════════════════════════════════════════════════════════════════════════════════════════════════
# CreatorOS — env mẫu cho bản cài TỰ VẬN HÀNH, gói REWARD ONLY
# ════════════════════════════════════════════════════════════════════════════════════════════════
#
# Cách dùng: chép file này thành `.env` trên máy chủ, rồi điền các chỗ <…>.
#
# Hướng dẫn từng bước, kèm bảng các lỗi KHÔNG hiện thông báo: `reward-only-setup.md` nằm cùng
# thư mục với file này.
#
# 🔴 HAI GIÁ TRỊ Ở MỤC ⓪ DO DISO CẤP VÀ ĐI THÀNH CẶP. Sửa một cái mà không sửa cái kia thì
#    tính năng Reward ngừng hoạt động — và KHÔNG có thông báo lỗi nào.
# ════════════════════════════════════════════════════════════════════════════════════════════════


# ── ⓪ DISO CẤP — chép nguyên, đừng sửa một ký tự ────────────────────────────────────────────────

# Mã bản quyền Diso cấp riêng cho quý công ty. Chép nguyên chuỗi, không xuống dòng, không thêm
# dấu cách. Chuỗi này gắn với giá trị DEPLOYMENT_ID ngay bên dưới.
LICENSE_KEY=<Diso cấp>

# Tên định danh hệ thống, do Diso chốt và báo lại. Phải khớp CHÍNH XÁC với mã bản quyền ở trên.
# 🔴 Bỏ trống hoặc gõ sai ⇒ toàn bộ tính năng Reward ngừng hoạt động.
DEPLOYMENT_ID=<Diso cấp, ví dụ acme-prod>


# ── ① CƠ SỞ DỮ LIỆU — BA VAI, KHÔNG ĐƯỢC GỘP ───────────────────────────────────────────────────
#
# 🔴 `?schema=creator_os`, KHÔNG phải `?schema=public`. Trỏ public thì baseline chạy được vài bước
#    rồi dừng giữa chừng, và cơ sở dữ liệu kẹt ở trạng thái dở dang — phải xoá đi tạo lại từ đầu.

# Vai APP — NOSUPERUSER, NOBYPASSRLS. Runtime của api dùng vai này.
# 🔴 TÊN CỐ ĐỊNH `creator_os_app`. Migration chỉ cấp quyền bảng cho đúng tên này — đặt tên khác thì
#    migration vẫn báo thành công, còn ứng dụng thiếu quyền ở mọi bảng.
# Cho vai này vượt được quy tắc lọc theo đơn vị = hàng rào cách ly dữ liệu giữa các đơn vị thành
# trang trí.
DATABASE_URL=postgresql://creator_os_app:<mk>@<host>:5432/<db>?schema=creator_os

# Vai CHỦ SỞ HỮU — tạo và cập nhật cấu trúc bảng. Sở hữu cơ sở dữ liệu và schema `creator_os`, và
# cần BYPASSRLS: một số migration ghi dữ liệu mặc định vào bảng có quy tắc lọc. Tên tuỳ chọn, nhưng
# MỌI lần chạy migration phải dùng CÙNG vai này — bảng mới chỉ tự có quyền khi do đúng vai này tạo.
DATABASE_URL_MIGRATE=postgresql://<owner>:<mk>@<host>:5432/<db>?schema=creator_os

# Vai WORKER — BYPASSRLS nhưng KHÔNG superuser. Dùng cho các tác vụ nền phải đọc dữ liệu của nhiều
# đơn vị. 🔴 TÊN CỐ ĐỊNH `creator_os_worker`, cùng lý do như vai APP.
# 🔴 THIẾU NÓ KHÔNG BÁO LỖI GÌ, và đó mới là vấn đề: code rơi về
#    `DATABASE_URL_WORKER || DATABASE_URL_MIGRATE || DATABASE_URL`, nên nó âm thầm dùng vai OWNER.
#    Ba vai co còn hai, và vai vượt được quy tắc lọc mang luôn quyền sửa cấu trúc DB.
DATABASE_URL_WORKER=postgresql://creator_os_worker:<mk>@<host>:5432/<db>?schema=creator_os


# ── ② HÀNG ĐỢI ─────────────────────────────────────────────────────────────────────────────────

REDIS_URL=redis://<host>:6379

# 🔴 Nếu có nhiều hệ thống dùng CHUNG một Redis, mỗi hệ thống phải đặt giá trị KHÁC NHAU.
#    Trùng nhau thì hệ thống này sẽ xử lý nhầm công việc của hệ thống kia.
QUEUE_PREFIX=<ten-cum-duy-nhat>


# ── ③ TIẾN TRÌNH — cái DUY NHẤT mặc định TẮT ───────────────────────────────────────────────────
#
# RUN_API / RUN_CONSOLE / RUN_CREATOR / RUN_REWARD mặc định BẬT. Riêng RUN_WORKER mặc định TẮT,
# và đó là chủ ý: chạy nhiều container mà bật worker ở nhiều bản là CHI TIỀN TRÙNG.
# 🔴 Cái giá: cụm một-container mà quên khai thì KHÔNG AI CHẠY JOB, cũng không báo gì.
#    Khai `true` ở ĐÚNG MỘT container.
RUN_WORKER=true

PORT=4700

# 🔴 PHẢI gõ đúng 127.0.0.1. KHÔNG dùng localhost, không dùng tên miền.
#    Đây là địa chỉ nội bộ trong máy chủ, trình duyệt không bao giờ thấy nó.
#    Đặt sai thì trang trắng và log không có dòng nào — rất khó dò.
API_ORIGIN=http://127.0.0.1:4700


# ── ④ TÊN MIỀN VÀ PHIÊN ────────────────────────────────────────────────────────────────────────

# Quý công ty TỰ SINH, chuỗi ngẫu nhiên dài. Diso không giữ bản sao.
JWT_SECRET=<tự sinh>

# Gốc để dựng link trong email (mời, đặt lại mật khẩu). Kết thúc bằng /console.
APP_ORIGIN=https://<ten-mien-cua-quy-cong-ty>/console
# Địa chỉ webview người chơi. Kết thúc bằng /reward — thiếu thì người chơi bị đưa tới trang không tồn tại.
REWARD_PORTAL_URL=https://<ten-mien>/reward
# Địa chỉ Console cho link trong email. Kết thúc bằng /console.
CONSOLE_PORTAL_URL=https://<ten-mien>/console

# Bí mật cho cửa nội bộ (certbot gọi báo chứng chỉ sẵn sàng). BẮT BUỘC — thiếu thì API không khởi động.
# Quý công ty TỰ SINH: openssl rand -hex 32. Dùng cùng giá trị trong header X-Internal-Secret của certbot.
INTERNAL_API_SECRET=<tự sinh>

PLATFORM_BASE_DOMAINS=<ten-mien-goc>

# Số hop proxy đứng trước app. Đặt sai thì IP client đọc ra sai — ảnh hưởng chống gian lận.
TRUST_PROXY_HOPS=1


# ── ⑤ BẢO VỆ THÔNG TIN NGƯỜI DÙNG — BẮT BUỘC, không phải tuỳ chọn ──────────────────────────────
#
# Hệ thống dùng hai khoá này để che mã người dùng trong nhật ký và dữ liệu đối soát. Đường nhận sự
# kiện từ hệ thống của quý công ty luôn đi qua đây, nên không bỏ trống được.
#
# 🔴 GIỮ KỸ VÀ SAO LƯU Ở NƠI TÁCH KHỎI MÁY CHỦ. Mất hai khoá này là mất khả năng đọc lại dữ liệu
#    đã mã hoá — không ai khôi phục được, kể cả Diso.
PII_ENCRYPTION_KEY=<tự sinh, GIỮ KỸ>

# 🔴 BỎ TRỐNG KHÔNG BÁO LỖI, nhưng hệ thống sẽ tự dùng JWT_SECRET thay thế. Hậu quả: về sau nếu
#    đổi JWT_SECRET (việc bình thường khi xử lý sự cố đăng nhập) thì TOÀN BỘ dữ liệu đối soát cũ
#    không khớp được nữa. Luôn đặt giá trị riêng, và đừng bao giờ đặt trùng JWT_SECRET.
PII_HASH_PEPPER=<tự sinh, GIỮ KỸ>


# ── ⑥ LƯU TRỮ TỆP — cần nếu chiến dịch có ảnh/tệp ──────────────────────────────────────────────

MINIO_ENDPOINT=<host>
MINIO_PORT=9000
MINIO_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=<tự sinh>
MINIO_SECRET_KEY=<tự sinh>
MINIO_BUCKET=creatoros
MINIO_PUBLIC_BUCKET=creatoros-public
MINIO_PRIVATE_BUCKET=creatoros-private
MINIO_PII_BUCKET=creatoros-pii
MINIO_PUBLIC_URL=https://<ten-mien-tep>


# ── ⑦ ĐĂNG NHẬP MẠNG XÃ HỘI — tuỳ chọn, nhưng hỏng thì hỏng CÂM ────────────────────────────────
#
# 🔴 Thiếu khoá của nhà cung cấp nào thì NÚT của nhà cung cấp đó BIẾN MẤT LẶNG LẼ — không lỗi nào
#    báo, trang đăng nhập vẫn lên bình thường.
# Khoá là của ỨNG DỤNG DO QUÝ CÔNG TY ĐĂNG KÝ, không phải của Diso.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SOCIAL_OAUTH_REDIRECT_URI=https://<ten-mien>/auth/callback
AUTH_PROVIDER_MODE=oauth


# ── ⑧ GỬI EMAIL — cần cho đăng nhập và khôi phục mật khẩu ──────────────────────────────────────
#
# Hệ thống gửi mã xác thực (OTP) và email khôi phục mật khẩu qua Brevo. Bỏ trống thì người dùng
# KHÔNG đăng nhập được bằng email.
#
# Bốn giá trị dưới đây được kiểm ngay khi khởi động: để trống một cái là hệ thống báo lỗi rõ ràng,
# không chạy tiếp trong trạng thái nửa vời.
NOTIFICATION_DEFAULT_PROVIDER=brevo
BREVO_API_KEY=<khoá API của tài khoản Brevo do quý công ty đăng ký>
BREVO_FROM_EMAIL=<địa chỉ gửi đi, ví dụ no-reply@ten-mien-cua-quy-vi>
BREVO_FROM_NAME=<tên hiển thị của người gửi>
BREVO_REPLY_TO=<địa chỉ nhận thư trả lời>

# ⚠️ KHÔNG cần khai gì thêm để hệ thống gửi email — điền xong năm dòng trên là gửi được.
#
#    Nói riêng về `NOTIFICATION_MODE`: đây KHÔNG phải công tắc bật gửi, nó là công tắc TẮT gửi, và
#    chỉ dành cho máy chạy thử. Nó nhận đúng MỘT giá trị có tác dụng:
#
#        NOTIFICATION_MODE=console    ⇒  KHÔNG gửi email thật, chỉ ghi ra nhật ký
#
#    Mọi thứ khác — để trống, `off`, `false`, hay không khai dòng này — đều cho ra CÙNG kết quả:
#    gửi email thật.
#
# 🔴 Vì vậy đừng chép `.env` từ máy chạy thử sang máy chủ thật. Nếu chuỗi `console` đi theo, người
#    dùng sẽ KHÔNG BAO GIỜ nhận được mã xác thực, mà hệ thống vẫn chạy bình thường và không báo lỗi
#    gì cả. Cách kiểm nhanh sau khi cài: tự đăng ký một tài khoản và xem hộp thư có nhận được mã
#    không — đó là phép thử duy nhất chắc chắn.


# ════════════════════════════════════════════════════════════════════════════════════════════════
# KHÔNG CẦN CHO GÓI REWARD ONLY — cố ý KHÔNG kê ở trên
# ════════════════════════════════════════════════════════════════════════════════════════════════
#
# Các khoá dưới đây thuộc những cụm license reward-only KHÔNG cấp (`content`, `affiliate`,
# `booking`). Để trống, đừng xin Diso:
#
#   ATCORE_*        PUB2_*          GEMINI_*        VERTEX_*
#   AUDIENCE_*      CRAWL_*         EKYC_*          OCR_*
#   CONTRACT_*      REVIEW_*        ENRICHMENT_*    AFFILIATE_*
#
# 🔴 Điền chúng cũng KHÔNG mở được tính năng — trần cụm do license quyết, không do env.
#
# Ba thiết lập sau do Diso quản, cố định trong bản dựng. Thêm vào file này sẽ bị BỎ QUA:
#   · bật/tắt kiểm tra license
#   · khoá xác thực license
#   · thời gian ân hạn sau khi hết hạn (30 ngày)
# Cần thay đổi thì liên hệ Diso để nhận bản dựng phù hợp.
# ════════════════════════════════════════════════════════════════════════════════════════════════
